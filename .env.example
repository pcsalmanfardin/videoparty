# Copy this file to .env for local testing (Render: add these under Environment tab instead).
# Without these set, the app falls back to storing uploads on local disk (fine for
# testing, but files are lost on restart/redeploy on most free hosts).
#
# These values come from Backblaze B2 (chosen because its free 10GB tier needs no
# credit card at signup — as long as the bucket is kept PRIVATE). See README.md
# for the step-by-step setup. The app serves videos through its own /media route
# using short-lived signed URLs, so the bucket never needs to be made public.

B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key
# The S3-compatible endpoint host for your bucket's region, WITHOUT "https://"
# e.g. s3.us-west-004.backblazeb2.com  (shown on your bucket's details page)
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# The region code embedded in the endpoint above, e.g. us-west-004
B2_REGION=us-west-004
B2_BUCKET_NAME=videoparty

# Optional: a secret only you know, used to reach the hidden admin page at
# /admin/<ADMIN_KEY>. There you can flip the whole site ON/OFF with one click —
# when OFF, nobody (even with the link) can create/join a room or upload a
# video. Regular visitors never see or need this key; it's yours alone.
# Leave unset to disable the switch (site is then always ON for everyone).
ADMIN_KEY=choose-a-long-random-secret
